LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=
# Copy an exact model ID from your provider's model catalog.
OPENROUTER_MODEL=

# Use the exact model name installed on your local Ollama server.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Any OpenAI-compatible Chat Completions endpoint.
CUSTOM_API_KEY=
CUSTOM_MODEL=
CUSTOM_BASE_URL=
# json_schema, json_object, or prompted_json; also available for each provider prefix.
CUSTOM_OUTPUT_MODE=json_schema
